{
  "name": "lameass.recipes",
  "version": "2.0",
  "description": "A recipe site, but without the 2,500 word storytime recipes.",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "prepare": "husky && npm run generate-schema",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning",
    "astro": "astro",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\" && gql.tada generate-output'"
  },
  "author": "Alec Lomas <alec@lowmess.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowmess/lameass.recipes.git"
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@datocms/astro": "^0.6.16",
    "@datocms/cda-client": "^0.3.2",
    "@fontsource/rock-salt": "^5.3.0",
    "astro": "^7.3.1",
    "datocms-structured-text-to-plain-text": "^6.0.0",
    "datocms-structured-text-utils": "^6.0.1",
    "fuse.js": "^7.5.0",
    "gql.tada": "^1.11.3",
    "postcss-preset-env": "^11.5.1",
    "react": "^19.2.8",
    "sanitize.css": "^13.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.11",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "!(*.d.ts)*.{js,cjs,mjs,jsx,ts,tsx,astro}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
