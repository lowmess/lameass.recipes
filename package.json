{
  "name": "lameass.recipes",
  "version": "2.0",
  "description": "A recipe site, but without the 2,500 word storytime recipes.",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "prepare": "husky && npm run generate-schema",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check --minimumFailingSeverity warning",
    "astro": "astro",
    "generate-schema": "dotenv -c -- bash -c 'gql.tada generate schema https://graphql.datocms.com --header \"X-Exclude-Invalid: true\" --header \"Authorization: $DATOCMS_PUBLISHED_CONTENT_CDA_TOKEN\"'"
  },
  "author": "Alec Lomas <alec@lowmess.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/lowmess/lameass.recipes.git"
  },
  "license": "MIT",
  "dependencies": {
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.1",
    "@astrojs/vercel": "^9.0.3",
    "@datocms/astro": "^0.6.4",
    "@datocms/cda-client": "^0.2.10",
    "@fontsource/rock-salt": "^5.2.8",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "^5.16.8",
    "datocms-structured-text-to-plain-text": "^5.1.7",
    "datocms-structured-text-utils": "^5.1.7",
    "fuse.js": "^7.1.0",
    "gql.tada": "^1.9.0",
    "postcss-preset-env": "^10.6.1",
    "sanitize.css": "^13.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/ts-plugin": "^1.10.6",
    "@types/node": "^25.0.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "lint-staged": {
    "!(*.d.ts)*.{js,cjs,mjs,jsx,ts,tsx,astro}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
