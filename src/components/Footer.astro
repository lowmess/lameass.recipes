---
import Container from "#components/Container.astro";
---

<footer>
	<Container class="grid">
		<div>
			<h2 class="section-heading">Site</h2>

			<ul>
				<li>
					<a href="/" class="link-ghost">Home</a>
				</li>

				<li>
					<a href="/recipes" class="link-ghost">Recipes</a>
				</li>

				<li>
					<a href="/meals" class="link-ghost">Meals</a>
				</li>

				<li>
					<a href="/categories" class="link-ghost">Categories</a>
				</li>

				<li>
					<a href="/tags" class="link-ghost">Tags</a>
				</li>
			</ul>
		</div>

		<div>
			<h2 class="section-heading">About</h2>

			<p>
				lameass.recipes is a digital cookbook written by <a
					href="https://instagram.com/kayla_lameass"
					class="link-themed">Kayla Lomas</a
				> and designed by <a href="https://lowmess.com" class="link-themed"
					>Alec Lomas</a
				>.
			</p>
		</div>

		<h2 class="tagline">
			Cooking:
			<br />
			&ldquo;It&apos;s <span class="themed-text">Fun</span>!&rdquo;&trade;
		</h2>
	</Container>
</footer>

<style>
	footer {
		--theme: var(--color-gray-2);

		padding-block: var(--rhythm-xl);
		background-color: var(--color-accent);
		color: var(--color-gray-10);
		font-size: var(--font-size-sm);
	}

	ul {
		margin-block: 0;
		padding-inline: var(--space-sm);
		text-transform: lowercase;
		list-style-type: none;
		column-gap: var(--space-md);

		@media (min-width: 32em) {
			column-count: 2;
		}
	}

	p {
		margin-block: 0;
		padding-inline: var(--space-sm);
	}

	.grid {
		display: grid;
		row-gap: var(--rhythm-lg);
		column-gap: var(--space-md);

		@media screen and (min-width: 26em) {
			grid-template-columns: 1fr 3fr;
		}

		@media screen and (min-width: 32em) {
			grid-template-columns: 1fr 2fr;
		}

		@media screen and (min-width: 50em) {
			grid-template-columns: 1fr 2fr max-content;
			column-gap: var(--space-lg);
		}

		@media screen and (min-width: 62em) {
			grid-template-columns: 2fr 3fr max-content;
			column-gap: var(--space-xl);
		}
	}

	.section-heading {
		margin-block-start: 0;
		margin-block-end: var(--rhythm-sm);
		border-block-end: 4px solid var(--color-gray-2);
		padding-inline: var(--space-sm);
		font-size: var(--font-size-lg);
		font-weight: 500;
	}

	.tagline {
		justify-self: center;
		margin-block: 0;
		font-size: var(--font-size-xxl);
		font-weight: 600;
		line-height: var(--line-height-solid);

		@media screen and (min-width: 26em) {
			grid-column: 1/3;
		}

		@media screen and (min-width: 50em) {
			grid-column: auto;
		}
	}
</style>
