---
import Logo from "#icons/logo.svg";
---

<nav>
	<a href="#main-content" class="skip-nav-link"> Skip to main content </a>

	<div class="nav-content">
		<a href="/" class="logo link-ui" title="Go to homepage">
			<Logo />
		</a>

		<ul>
			<li>
				<a href="/recipes" class="link-ghost">Recipes</a>
			</li>

			<li>
				<a href="/meals" class="link-ghost">Meals</a>
			</li>

			<li>
				<a href="/categories" class="link-ghost">Categories</a>
			</li>
		</ul>
	</div>
</nav>

<style>
	nav {
		position: relative;
	}

	.skip-nav-link {
		position: absolute;
		opacity: 0;
		pointer-events: none;

		&:focus {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.nav-content {
		text-align: center;
	}

	.logo {
		--theme: var(--color-accent);
		display: block;
		position: relative;
		top: var(--rhythm-sm);
		max-width: calc(var(--space-xxl) * 3);
		margin-inline: auto;
		padding-inline: var(--space-md);

		svg {
			filter: drop-shadow(2px 2px 0px var(--color-background))
				drop-shadow(2px -2px 0px var(--color-background))
				drop-shadow(-2px 2px 0px var(--color-background))
				drop-shadow(-2px 2px 0px var(--color-background));
		}
	}

	ul {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-md);
		width: 100vw;
		margin-block: 0;
		margin-inline-start: calc(50% - 50vw);
		padding-block-start: var(--rhythm-xs);
		padding-block-end: var(--rhythm-sm);
		padding-inline: var(--space-lg);
		border-block: 2px solid var(--color-accent);
		text-transform: lowercase;
		white-space: nowrap;
		overflow-x: auto;

		@media (min-width: 64em) {
			gap: var(--space-lg);
		}
	}

	li + li::before {
		content: "\2022";
		margin-inline-end: var(--space-md);
		color: var(--color-accent);

		@media (min-width: 64em) {
			margin-inline-end: var(--space-lg);
		}
	}
</style>
