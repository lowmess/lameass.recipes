---
import { StructuredText } from "@datocms/astro";
import type { HTMLTag, Polymorphic } from "astro/types";

import type { FragmentOf } from "#api/datocms/graphql.ts";
import type { RecipePreviewFragment } from "#api/queries/recipe.ts";
import Sticker from "#components/Sticker.astro";
import type { Category } from "#types/category.ts";
import { getDisplacementValues } from "#util/displacement.ts";
import { pluralize } from "#util/grammar.ts";
import { toFraction } from "#util/number.ts";
import { minutesToHours } from "#util/time.ts";
import { getUnit } from "#util/units.ts";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	recipe: FragmentOf<typeof RecipePreviewFragment>;
	headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}>;

const {
	as: Tag = "div",
	recipe,
	headingLevel: Heading = "h2",
	class: className,
	...props
}: Props<HTMLTag> = Astro.props;

const {
	title,
	slug,
	category,
	prepTime = 0,
	cookTime = 0,
	totalTime = 0,
	yields,
	description,
	tags,
} = recipe;

const time = totalTime || (prepTime || 0) + (cookTime || 0);

// category is a required field
const theme = `var(--color-${category!.color})`;

const {
	verticalOffset: stickerVerticalOffset,
	horizontalOffset: stickerHorizontalOffset,
	rotation: stickerRotation,
} = getDisplacementValues({
	maxVerticalOffset: 4,
	maxHorizontalOffset: 12,
	maxRotation: 15,
});

let yieldString;

if (yields.unit === "servings") {
	yieldString = `Serves ${yields.amount}`;
} else {
	const unit = getUnit(yields.unit);

	if (unit) {
		const amount = toFraction(yields.amount);

		yieldString = `Yields ${amount} ${pluralize(yields.amount, unit, `${unit}s`)}`;
	}
}
---

<Tag class:list={["card", className]} {...props}>
	<Heading class="title"
		><a href={`/recipes/${slug}`} class="link-ui">{title}</a></Heading
	>

	<a href={`/categories/${category!.slug}`} class="link-ui category-sticker"
		><Sticker category={category!.slug as Category} /></a
	>

	{
		description && (
			<div class="description">
				<StructuredText data={description} />
			</div>
		)
	}

	<div class="info-ribbon">
		{time > 0 && <span>{minutesToHours(time)}</span>}

		{yieldString && <span>{yieldString}</span>}

		{
			tags.map((tag) => (
				<a href={`/tags/${tag.slug}`} class="link-ghost">
					{tag.title}
				</a>
			))
		}
	</div>
</Tag>

<style
	define:vars={{
		theme,
		stickerVerticalOffset,
		stickerHorizontalOffset,
		stickerRotation,
	}}
>
	.card {
		--theme: var(--theme);

		position: relative;
		max-width: 48rem;
		border: var(--space-xs) solid;
		border-color: var(--color-gray-10);
		padding: var(--space-md);
		background-color: var(--color-white);
		box-shadow: 0 -8px 16px -4px rgb(0 0 0 / 0.25);

		@media (prefers-color-scheme: dark) {
			border-color: var(--color-black);
			background-color: var(--color-beige-9);
		}

		:not(h1, h2, h3, h4, h5, h6) a:hover {
			color: var(--theme);
		}
	}

	.title {
		margin-block: 0;
		margin-block-end: var(--rhythm-sm);
		font-size: var(--font-size-xl);
		font-weight: 400;
	}

	.category-sticker {
		position: absolute;
		top: var(--space-sm);
		right: var(--space-md);
		width: var(--space-xxl);
		height: var(--space-xxl);
		transform: translateX(var(--stickerHorizontalOffset))
			translateY(var(--stickerVerticalOffset)) rotateZ(var(--stickerRotation));

		svg {
			width: 100%;
			height: 100%;
			filter: drop-shadow(0px 2px 1px rgb(0 0 0 / 0.2));
		}
	}

	.info-ribbon {
		display: flex;
		gap: var(--space-sm);
		width: 100%;
		margin-block-start: var(--rhythm-lg);
		border-block-start: 2px solid var(--theme, var(--color-accent));
		padding-block-start: var(--rhythm-sm);
		font-size: var(--font-size-sm);
		font-family: var(--font-family-rock-salt);

		& > * + *::before {
			content: "\2022";
			color: var(--theme, var(--color-accent));
			margin-inline-end: var(--space-sm);
		}
	}

	.description {
		padding-inline-end: var(--space-xxl);
	}

	:global(.card .description p) {
		max-width: 55ch;
		margin: 0;
		text-wrap: pretty;
		/* font-size: var(--font-size-sm); */
	}
</style>
