---
import { StructuredText } from "@datocms/astro";
import type { HTMLTag, Polymorphic } from "astro/types";

import type { FragmentOf } from "#api/datocms/graphql.ts";
import type { RecipePreviewFragment } from "#api/queries/recipe.ts";
import CocktailIcon from "#components/icons/Cocktail.svg";
import DessertIcon from "#components/icons/Dessert.svg";
import IngredientIcon from "#components/icons/Ingredient.svg";
import MainDishIcon from "#components/icons/MainDish.svg";
import SideDishIcon from "#components/icons/SideDish.svg";
import SnackIcon from "#components/icons/Snack.svg";
import Ribbon from "#components/Ribbon.astro";
import { Category } from "#types/category.ts";
import type { Measurement } from "#types/recipe.ts";
import { pluralize } from "#util/grammar.ts";
import { toFraction } from "#util/number.ts";
import { minutesToHours } from "#util/time.ts";
import { getUnit } from "#util/units.ts";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	recipe: FragmentOf<typeof RecipePreviewFragment>;
	headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}>;

const {
	as: Tag = "div",
	recipe,
	headingLevel: Heading = "h2",
	class: className,
	...props
}: Props<HTMLTag> = Astro.props;

const {
	title,
	slug,
	category,
	prepTime = 0,
	cookTime = 0,
	totalTime = 0,
	description,
	tags,
} = recipe;

const time = totalTime || (prepTime || 0) + (cookTime || 0);

// category is a required field
const theme = `var(--color-${category!.color})`;

const yields = recipe.yields as Measurement;
let yieldString;

if (yields.unit === "servings") {
	yieldString = `Serves ${yields.amount}`;
} else {
	const unit = getUnit(yields.unit);

	if (unit) {
		const amount = toFraction(yields.amount);

		yieldString = `Yields ${amount} ${pluralize(yields.amount, unit, `${unit}s`)}`;
	}
}

let IconComponent = MainDishIcon;

switch (category!.slug) {
	case Category.MainDish:
		IconComponent = MainDishIcon;
		break;

	case Category.SideDish:
		IconComponent = SideDishIcon;
		break;

	case Category.Dessert:
		IconComponent = DessertIcon;
		break;

	case Category.Snack:
		IconComponent = SnackIcon;
		break;

	case Category.Cocktail:
		IconComponent = CocktailIcon;
		break;

	case Category.Ingredient:
		IconComponent = IngredientIcon;
		break;
}
---

<Tag class:list={["card", className]} {...props}>
	<div class="header">
		<Heading class="title"
			><a href={`/recipes/${slug}`} class="link-ui">{title}</a></Heading
		>

		<div>
			<Ribbon as="a" href={`/categories/${category!.slug}`} class="ribbon">
				<IconComponent class="icon" />
			</Ribbon>
		</div>
	</div>

	{
		description && (
			<div class="description">
				<StructuredText data={description} />
			</div>
		)
	}

	<div class="info-ribbon">
		{time > 0 && <span>{minutesToHours(time)}</span>}

		{yieldString && <span>{yieldString}</span>}

		{
			tags.map((tag) => (
				<a href={`/tags/${tag.slug}`} class="link-ghost">
					{tag.title}
				</a>
			))
		}
	</div>
</Tag>

<style
	define:vars={{
		theme,
	}}
>
	.card {
		--theme: var(--theme);

		position: relative;
		max-width: 48rem;
		border: var(--space-xs) solid;
		border-color: var(--color-gray-10);
		padding: var(--space-md);
		background-color: var(--color-white);
		box-shadow: 0 -8px 16px -4px rgb(0 0 0 / 0.25);

		@media (prefers-color-scheme: dark) {
			border-color: var(--color-black);
			background-color: var(--color-beige-9);
		}

		:not(h1, h2, h3, h4, h5, h6) a:hover {
			color: var(--theme);
		}
	}

	.header {
		display: flex;
		justify-content: space-between;
		gap: var(--space-md);
		padding-inline-end: var(--space-md);
	}

	.title {
		margin-block: 0;
		margin-block-end: var(--rhythm-md);
		font-size: var(--font-size-xl);
		font-weight: 400;
	}

	.ribbon::before {
		content: "";
		position: absolute;
		top: calc(var(--space-md) * -1);
		right: 0;
		bottom: calc(100% - 1px);
		left: 0;
		background-color: var(--theme, var(--color-accent));
	}

	.icon {
		position: relative;
		top: calc(var(--space-sm) * -1);
		width: var(--space-lg);
		aspect-ratio: 1;
		fill: var(--color-white);
	}

	.info-ribbon {
		display: flex;
		gap: var(--space-sm);
		width: 100%;
		margin-block-start: var(--rhythm-lg);
		border-block-start: 2px solid var(--theme, var(--color-accent));
		padding-block-start: var(--rhythm-sm);
		font-size: var(--font-size-sm);
		font-family: var(--font-family-rock-salt);

		& > * + *::before {
			content: "\2022";
			color: var(--theme, var(--color-accent));
			margin-inline-end: var(--space-sm);
		}
	}

	:global(.card .description p) {
		max-width: 55ch;
		margin: 0;
		text-wrap: pretty;
	}
</style>
