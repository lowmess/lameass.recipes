---
import type { HTMLAttributes } from "astro/types";
import { actions } from "astro:actions";

import SearchIcon from "#icons/search.svg";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<form method="POST" action={actions.search.recipes}>
	<div class:list={[className, "search-input"]} {...props}>
		<input type="search" name="query" placeholder="Search recipes" />

		<button>
			<SearchIcon />

			<span class="visually-hidden">Search</span>
		</button>
	</div>
</form>

<script>
	import { debounce } from "#util/debounce.ts";
	import { actions } from "astro:actions";

	const form = document.querySelector("form");
	const input = document.querySelector("input");
	const recipes = document.querySelectorAll("[data-id]");

	const performRecipeSearch = async () => {
		if (!form) {
			console.warn("No form found");
			return;
		}

		const formData = new FormData(form);

		const { data, error } = await actions.search.recipes(formData);

		if (error) {
			console.error(error);
		}

		console.log(data);

		for (const recipe of recipes) {
			// @ts-expect-error yes. yes it does exist
			const id = recipe.dataset.id;

			if (data?.includes(id) || !data?.length) {
				recipe.classList.remove("hidden");
			} else {
				recipe.classList.add("hidden");
			}
		}
	};

	const debouncedSearch = debounce(performRecipeSearch);

	input?.addEventListener("input", () => {
		debouncedSearch();
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		performRecipeSearch();
	});
</script>

<style>
	.search-input {
		display: flex;
		border: 4px solid var(--color-gray-10);
		border-radius: var(--space-xs);
		box-shadow: 0 4px 16px -2px rgb(0 0 0 / 0.25);
		overflow: hidden;

		@media (prefers-color-scheme: dark) {
			border-color: var(--color-black);
		}

		&:focus-within {
			outline: -webkit-focus-ring-color auto 1px;
		}

		input {
			flex: 1;
			border: 0;
			padding-block: var(--rhythm-xs);
			padding-inline: var(--space-sm);
			background-color: var(--color-white);
			font-size: var(--font-size-md);
			color: var(--color-gray-10);

			&:focus {
				outline: 0;
			}

			&::placeholder {
				color: var(--color-gray-6);
			}
		}

		button {
			height: calc(1lh + (var(--rhythm-sm) * 2));
			aspect-ratio: 1;
			border: 0;
			border-inline-start: 4px solid var(--color-gray-10);
			padding: var(--space-xs);
			background-color: var(--color-accent);

			@media (prefers-color-scheme: dark) {
				border-color: var(--color-black);
			}

			&:hover {
				background-color: hsl(
					from var(--color-accent) h calc(s - 25) calc(l - 5)
				);
			}

			&:focus {
				outline: 0;
			}
		}
	}
</style>
