---
import type { HTMLTag, Polymorphic } from "astro/types";

import type { FragmentOf } from "#api/datocms/graphql.ts";
import type { RecipePreviewFragment } from "#api/queries/recipe.ts";
import RecipeCard from "#components/recipe-card.astro";
import { getDisplacementValues } from "#util/displacement.ts";

type Props<Tag extends HTMLTag> = Polymorphic<{
	as: Tag;
	recipes: Array<FragmentOf<typeof RecipePreviewFragment>>;
	headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}>;

const {
	as: Tag = "div",
	recipes,
	headingLevel = "h2",
	class: className,
	...props
}: Props<HTMLTag> = Astro.props;
---

<div data-measure>
	<Tag class:list={["stack", className]} {...props}>
		{
			recipes.map((recipe, index) => {
				const { horizontalOffset, rotation } = getDisplacementValues({});

				return (
					<RecipeCard
						recipe={recipe}
						headingLevel={headingLevel}
						class="card--stacked"
						style={`--displacement: ${horizontalOffset}; --rotation: ${rotation}; --count: ${index};`}
					/>
				);
			})
		}
	</Tag>
</div>

<style>
	div[data-measure] {
		container-type: inline-size;
	}

	.stack {
		--offset: 2rlh;
		/** 0 when viewport and element are same width, 1 otherwise */
		--stack-is-not-full-width: sign(
			100vw - calc(100cqw + (var(--container-padding) * 2))
		);

		display: grid;
		max-width: max-content;
		margin-block: var(--offset);
		margin-inline: auto;
	}

	.card--stacked {
		grid-row: calc(var(--count) * 23 + 1) / span 24;
		grid-column: 1;
		transform: translateX(
				max(
					calc(var(--displacement) * 0.25),
					calc(var(--displacement) * var(--stack-is-not-full-width))
				)
			)
			rotateZ(var(--rotation));
		will-animate: transform;

		@media (any-pointer: fine) and (any-hover: hover) and (prefers-reduced-motion: no-preference) {
			grid-row: calc(var(--count) * 3 + 1) / span 4;
			transition: transform 0.3s ease;

			&:hover {
				transform: translateY(calc(var(--offset) * -1));
			}

			&:hover ~ .card--stacked {
				transform: translateY(calc(var(--offset) * 0.5))
					translateX(var(--displacement)) rotateZ(var(--rotation));
			}
		}
	}
</style>
