---
import { actions } from "astro:actions";

import { executeQuery } from "#api/datocms/execute-query.ts";
import type { ResultOf } from "#api/datocms/graphql.ts";
import { getAllCategories } from "#api/queries/category.ts";
import { getRecipesByCategory } from "#api/queries/recipe.ts";
import CategoryTitle from "#components/category-title.astro";
import RecipeStack from "#components/recipe-stack.astro";
import Search from "#components/search.astro";
import GlobalLayout from "#layouts/global-layout.astro";

export async function getStaticPaths() {
	const { allCategories } = await executeQuery(getAllCategories);

	return allCategories.map((category) => ({
		params: { slug: category.slug },
		props: category,
	}));
}
type Props = ResultOf<typeof getAllCategories>["allCategories"][number];

const category: Props = Astro.props;

const { id, slug } = category;

if (!slug) {
	throw new Error("Category missing slug");
}

const result = Astro.getActionResult(actions.search.recipes);

const { allRecipes } = await executeQuery(getRecipesByCategory, {
	variables: { categoryId: id },
});

let recipes = allRecipes;

if (result?.data?.length) {
	recipes = allRecipes.filter((recipe) => result.data.includes(recipe.id));
}
---

<GlobalLayout>
	<CategoryTitle category={category} as="h1" />

	<Search class="search" />

	<RecipeStack recipes={recipes} />
</GlobalLayout>

<style>
	.search {
		position: relative;
		top: calc(var(--rhythm-md) * -1);
		max-width: calc(var(--container-width) * 0.5);
		margin-inline: auto;
	}
</style>
