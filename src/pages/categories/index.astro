---
import { executeQuery } from "#api/datocms/execute-query.ts";
import { getAllCategories } from "#api/queries/category.ts";
import CategoryTitle from "#components/CategoryTitle.astro";
import GlobalLayout from "#layouts/GlobalLayout.astro";

const { allCategories } = await executeQuery(getAllCategories);
---

<GlobalLayout>
	<h1 class="visually-hidden">Categories</h1>

	<div class="categories">
		{
			allCategories.map((category) => (
				<CategoryTitle category={category} as="a" />
			))
		}
	</div>
</GlobalLayout>

<style>
	.categories {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-block: var(--rhythm-xl);
	}

	.category {
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: 1fr;
		align-items: center;
		width: max-content;
		text-align: center;
		font-size: var(--font-size-xxxl);

		@media (min-width: 40em) {
			font-size: var(--font-size-huge);
		}
	}

	a,
	svg {
		grid-column: 1/1;
		grid-row: 1/1;
		transition:
			color 0.3s ease,
			opacity 0.2s ease;
	}

	a {
		position: relative;
		z-index: 2;
		font-family: var(--font-family-henrietta);

		&:hover {
			z-index: 1;
			opacity: 0.25;

			& + svg {
				z-index: 2;
				opacity: 1;
				color: var(--theme, var(--color-accent));
			}
		}
	}

	svg {
		position: relative;
		z-index: 1;
		width: 2em;
		margin-inline: auto;
		opacity: 0.25;
		pointer-events: none;
	}
</style>
