---
import { executeQuery } from "#api/datocms/execute-query.ts";
import { getAllMeals } from "#api/queries/meal.ts";
import Container from "#components/container.astro";
import MealPreview from "#components/meal-preview.astro";
import PageTitle from "#components/page-title.astro";
import GlobalLayout from "#layouts/global.astro";

const { allMeals } = await executeQuery(getAllMeals);
---

<GlobalLayout title="Meals">
	<Container>
		<PageTitle>The menu</PageTitle>

		<div class="meals">
			{allMeals.map((meal) => <MealPreview meal={meal} />)}
		</div>
	</Container>
</GlobalLayout>

<style>
	.meals {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-xl);
		margin-block-end: var(--rhythm-xxl);
	}
</style>
