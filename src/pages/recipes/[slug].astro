---
import { StructuredText } from "@datocms/astro";
import { isEmptyDocument } from "datocms-structured-text-utils";

import { executeQuery } from "#api/datocms/execute-query.ts";
import type { ResultOf } from "#api/datocms/graphql.ts";
import { getAllRecipes, getRecipeById } from "#api/queries/recipe.ts";
import Card from "#components/card.astro";
import Container from "#components/container.astro";
import Ingredient from "#components/ingredient.astro";
import NestedHeading from "#components/nested-heading.astro";
import RecipeLink from "#components/recipe-link.astro";
import GlobalLayout from "#layouts/global-layout.astro";
import type { Measurement } from "#types/recipe.ts";
import type { Unit } from "#types/unit.ts";
import { getDisplacementValues } from "#util/displacement.ts";
import { minutesToHours } from "#util/time.ts";
import { getUnit, pluralizeAmountWithUnit } from "#util/units.ts";

export async function getStaticPaths() {
	const { allRecipes } = await executeQuery(getAllRecipes);

	return allRecipes.map((tag) => ({
		params: { slug: tag.slug },
		props: tag,
	}));
}
type Props = ResultOf<typeof getAllRecipes>["allRecipes"][number];

const { id, slug }: Props = Astro.props;

if (!slug) {
	throw new Error("Recipe missing slug");
}

const { recipe } = await executeQuery(getRecipeById, {
	variables: { id },
});

if (!recipe) {
	throw new Error(`Recipe with id "${id}" not found`);
}

const {
	title,
	category,
	prepTime = 0,
	cookTime = 0,
	totalTime = (prepTime ?? 0) + (cookTime ?? 0),
	description,
	tags,
	equipment,
	ingredients,
	directions,
} = recipe;

const yields = recipe.yields as Measurement;
let yieldLabel: string = "Serves";
const baseYieldAmount = yields.amount;
let yieldValue: string = yields.amount.toString();
let yieldUnit: Unit | false;

if (yields.unit === "each") {
	yieldLabel = "Yields";
} else if (yields.unit !== "servings") {
	yieldUnit = getUnit(yields.unit);

	if (yieldUnit) {
		yieldLabel = `Yields`;
		yieldValue = pluralizeAmountWithUnit(yields.amount, yieldUnit);
	}
}

const {
	verticalOffset: infoVerticalOffset,
	horizontalOffset: infoHorizontalOffset,
	rotation: infoRotation,
} = getDisplacementValues({
	maxVerticalOffset: 32,
});

const {
	verticalOffset: eqVerticalOffset,
	horizontalOffset: eqHorizontalOffset,
	rotation: eqRotation,
} = getDisplacementValues({
	maxVerticalOffset: 32,
});

// category is a required field
const theme = `var(--color-${category!.color})`;
---

<GlobalLayout>
	<Container class="recipe">
		<h1>{title}</h1>

		{
			description && (
				<div class="description">
					<StructuredText data={description} />
				</div>
			)
		}

		<div
			class="recipe-meta"
			data-has-equipment={!!equipment && !isEmptyDocument(equipment)}
		>
			<Card class="card card--info">
				<div class="info-grid">
					<h2>Recipe Information</h2>

					<p class="contents">
						<span class="label">Category:</span>
						<a href={`/categories/${category!.slug}`} class="value link-ghost">
							{category!.title}
						</a>
					</p>

					{
						prepTime && prepTime > 0 && (
							<p class="contents">
								<span class="label">Prep time:</span>
								<span class="value">{minutesToHours(prepTime)}</span>
							</p>
						)
					}

					{
						cookTime && cookTime > 0 && (
							<p class="contents">
								<span class="label">Cook time:</span>
								<span class="value">{minutesToHours(cookTime)}</span>
							</p>
						)
					}

					{
						totalTime && totalTime > 0 && !prepTime && !cookTime && (
							<p class="contents">
								<span class="label">Time:</span>
								<span class="value">{minutesToHours(totalTime)}</span>
							</p>
						)
					}

					{
						yields && yieldLabel && yieldValue && (
							<>
								<p class="contents">
									<span class="label">{yieldLabel}:</span>

									<div class="value adjustment-container">
										<span
											data-yields
											data-yields-amount={baseYieldAmount}
											data-yields-unit={
												// @ts-expect-error it is not being used before it's assigned?
												yieldUnit || undefined
											}
										>
											{yieldValue}
										</span>

										<label for="serving-adjust" class="visually-hidden">
											Adjust servings
										</label>

										<select id="serving-adjust" name="serving-adjust">
											<option value="0.25">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 0.25,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x1/4)
											</option>

											<option value="0.5">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 0.5,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x1/2)
											</option>

											<option value="0.75">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 0.75,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x3/4)
											</option>

											<option value="1" selected>
												{pluralizeAmountWithUnit(
													baseYieldAmount,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x1)
											</option>

											<option value="1.5">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 1.5,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x1.5)
											</option>

											<option value="2">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 2,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x2)
											</option>

											<option value="4">
												{pluralizeAmountWithUnit(
													baseYieldAmount * 4,
													// @ts-expect-error it is not being used before it's assigned?
													yieldUnit,
												)}{" "}
												(x4)
											</option>
										</select>

										<span class="adjustment-display">
											(x<span data-ingredient-adjustment>1</span>)
										</span>
									</div>
								</p>
							</>
						)
					}

					{
						tags.length > 0 && (
							<>
								<p class="label">Tags:</p>

								<ul class="tags">
									{tags.map((tag) => (
										<li class="tag">
											<a href={`/tags/${tag.slug}`} class="link-ui">
												{tag.title}
											</a>
										</li>
									))}
								</ul>
							</>
						)
					}
				</div>
			</Card>

			{
				equipment && !isEmptyDocument(equipment) && (
					<Card class="card card--equipment">
						<h2>Equipment</h2>

						<StructuredText data={equipment} />
					</Card>
				)
			}
		</div>

		{
			ingredients && !isEmptyDocument(ingredients) && (
				<>
					<h2>Ingredients</h2>

					{/* @ts-expect-error not entirely sure how to get this data properly typed, since it should be pulling straight from dato */}
					<StructuredText
						data={ingredients}
						nodeOverrides={{
							heading: NestedHeading,
							paragraph: Ingredient,
						}}
						linkToRecordComponents={{
							RecipeRecord: RecipeLink,
						}}
					/>
				</>
			)
		}

		{
			directions && !isEmptyDocument(directions) && (
				<>
					<h2>Steps</h2>

					{/* @ts-expect-error not entirely sure how to get this data properly typed, since it should be pulling straight from dato */}
					<StructuredText
						data={directions}
						linkToRecordComponents={{
							RecipeRecord: RecipeLink,
						}}
						nodeOverrides={{
							heading: NestedHeading,
						}}
					/>
				</>
			)
		}
	</Container>
</GlobalLayout>

<script>
	import { toFraction } from "#util/number.ts";
	import { pluralizeAmountWithUnit, pluralizeUnit } from "#util/units.ts";

	const $select = document.querySelector('select[name="serving-adjust"]');
	const $yieldsEl = document.querySelector("[data-yields]");

	// @ts-expect-error `dataset` does absolutely exist on `Element`
	const yieldsBaseValue = parseFloat($yieldsEl?.dataset.yieldsAmount || "1");
	// @ts-expect-error `dataset` does absolutely exist on `Element`
	const yieldsUnit = $yieldsEl?.dataset.yieldsUnit;

	const ingredients = document.querySelectorAll("[data-ingredient]");
	const adjustmentDisplay = document.querySelector(
		"[data-ingredient-adjustment]",
	);

	$select?.addEventListener("change", (event) => {
		// @ts-expect-error yes it does dude
		const adjustmentAmount = parseFloat(event.target?.value || "1");

		// @ts-expect-error yes it does dude
		adjustmentDisplay.innerHTML = toFraction(adjustmentAmount);

		if ($yieldsEl) {
			const nextAmount = yieldsBaseValue * adjustmentAmount;
			$yieldsEl.innerHTML = pluralizeAmountWithUnit(nextAmount, yieldsUnit);
		}

		ingredients.forEach((ingredient) => {
			const $amountEl = ingredient.querySelector("[data-ingredient-amount]");
			const $unitEl = ingredient.querySelector("[data-ingredient-unit]");

			let amount = 1;

			if ($amountEl) {
				const initialAmount = parseFloat(
					$amountEl?.getAttribute("data-ingredient-amount") || "1",
				);

				amount = initialAmount * adjustmentAmount;

				$amountEl.innerHTML = toFraction(amount);
			}

			if ($unitEl) {
				const unit = $unitEl?.getAttribute("data-ingredient-unit") as string;
				$unitEl.innerHTML = pluralizeUnit(amount, unit);
			}
		});
	});
</script>

<style
	define:vars={{
		theme,
		infoVerticalOffset,
		infoHorizontalOffset,
		infoRotation,
		eqVerticalOffset,
		eqHorizontalOffset,
		eqRotation,
	}}
>
	.recipe {
		--theme: var(--theme, var(--color-accent));

		padding-block: var(--rhythm-lg);
	}

	h1 {
		margin-block-start: 0;
		margin-block-end: var(--rhythm-xs);
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-xxl);
		color: var(--theme);
	}

	h2 {
		margin-block: 0;
		font-size: var(--font-size-lg);
		font-weight: 400;
		text-decoration: underline;
		text-decoration-color: var(--theme);
	}

	:global(.recipe .description p) {
		max-width: 55ch;
		margin-block: 0;
		margin-inline: auto;
		text-align: center;
		text-wrap: pretty;
	}

	.recipe-meta {
		margin-block-start: var(--rhythm-md);
		margin-block-end: var(--rhythm-lg);

		.card--info {
			transform: translateX(var(--infoHorizontalOffset))
				rotateZ(var(--infoRotation));
		}

		&[data-has-equipment="true"] {
			display: grid;

			.card--info {
				z-index: 2;
			}

			.card--equipment {
				z-index: 1;
				transform: translateX(var(--eqHorizontalOffset))
					rotateZ(var(--eqRotation));
			}

			@media (min-width: 64em) {
				.card--info {
					grid-column: 8 / span 8;
					grid-row: 1;
					transform: translateY(var(--infoVerticalOffset))
						rotateZ(var(--infoRotation));
				}

				.card--equipment {
					grid-column: 1 / span 8;
					grid-row: 1;
					transform: translateY(var(--eqVerticalOffset))
						rotateZ(var(--eqRotation));
				}
			}
		}
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: var(--rhythm-sm);
		width: 100%;
		max-width: 40rem;
		margin-inline: auto;
		font-size: var(--font-size-sm);

		h2 {
			margin-block-end: var(--rhythm-sm);
			font-family: var(--font-family-basier);
			font-size: var(--font-size-md);
			font-weight: 600;
			text-decoration: none;
		}
	}

	.info-grid {
		display: grid;
		grid-template-columns: max-content 1fr;
		row-gap: var(--rhythm-sm);
		column-gap: var(--space-md);

		h2 {
			grid-column: 1/-1;
		}
	}

	.card--equipment {
		:global(ul) {
			display: flex;
			flex-direction: column;
			gap: var(--rhythm-sm);
			margin: 0;
			padding: 0;
			list-style-type: none;
		}

		:global(li) {
			border-bottom: 1px solid var(--color-text);
		}
	}

	.label {
		margin: 0;
		text-align: end;
	}

	.value {
		border-bottom: 1px solid var(--color-text);
	}

	label.visually-hidden {
		user-select: none;
	}

	.adjustment-display {
		color: var(--color-text-secondary);
	}

	.adjustment-container {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--space-sm);
		cursor: pointer;

		& select {
			position: absolute;
			inset: 0;
			opacity: 0;
		}
	}

	.select-icon {
		position: absolute;
		top: 0.05lh;
		right: var(--space-xs);
		width: 0.5lh;
		height: 0.5lh;
	}

	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		column-gap: 1ch;
		row-gap: var(--rhythm-sm);
		margin: 0;
		padding: 0;
		list-style-type: none;
	}

	.tag {
		font-family: var(--font-family-rock-salt);
		text-shadow:
			-2px 2px 0px var(--color-card-background),
			-2px -2px 0px var(--color-card-background),
			2px 2px 0px var(--color-card-background),
			2px -2px 0px var(--color-card-background);

		&::before {
			content: "";
			position: absolute;
			right: 0;
			bottom: 0;
			left: 0;
			z-index: -1;
			border-bottom: 1px solid var(--color-text);
		}

		&:not(:last-child)::after {
			content: ",";
			color: var(--theme);
		}
	}

	.striped-structured-text {
		margin: calc(var(--space-md) * -1);
		margin-block-start: var(--space-md);

		:global(& p) {
			margin-block: 0;
			padding-block: var(--rhythm-sm);
			padding-inline: var(--space-md);

			&:nth-of-type(odd) {
				background-color: hsl(from var(--color-background) h s l / 0.5);
			}
		}
	}
</style>
