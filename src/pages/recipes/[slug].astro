---
import { ensureValidStructuredTextProps, StructuredText } from "@datocms/astro";
import type { StructuredTextDocument } from "datocms-structured-text-to-plain-text";

import { executeQuery } from "#api/datocms/execute-query.ts";
import type { ResultOf } from "#api/datocms/graphql.ts";
import { getAllRecipes, getRecipeById } from "#api/queries/recipe.ts";
import Card from "#components/card.astro";
import Container from "#components/container.astro";
import Ingredient from "#components/ingredient.astro";
import ChevronDown from "#icons/chevron-down.svg";
import GlobalLayout from "#layouts/global-layout.astro";
import type { Measurement } from "#types/recipe.ts";
import { toFraction } from "#util/number.ts";
import { minutesToHours } from "#util/time.ts";
import { getUnit, pluralizeUnit } from "#util/units.ts";

export async function getStaticPaths() {
	const { allRecipes } = await executeQuery(getAllRecipes);

	return allRecipes.map((tag) => ({
		params: { slug: tag.slug },
		props: tag,
	}));
}
type Props = ResultOf<typeof getAllRecipes>["allRecipes"][number];

const { id, slug } = Astro.props;

if (!slug) {
	throw new Error("Recipe missing slug");
}

const { recipe } = await executeQuery(getRecipeById, {
	variables: { id },
});

if (!recipe) {
	throw new Error(`Recipe with id "${id}" not found`);
}

const {
	title,
	category,
	prepTime = 0,
	cookTime = 0,
	totalTime = (prepTime ?? 0) + (cookTime ?? 0),
	description,
	tags,
	equipment,
	ingredients,
	directions,
} = recipe;

const yields = recipe.yields as Measurement;
let yieldLabel: string = "Serves";
let yieldValue: string = yields.amount.toString();

if (yields.unit !== "servings") {
	const unit = getUnit(yields.unit);

	if (unit) {
		yieldLabel = `Yields`;
		yieldValue = `${toFraction(yields.amount)} ${pluralizeUnit(yields.amount, unit)}`;
	}
}

// category is a required field
const theme = `var(--color-${category!.color})`;
---

<GlobalLayout>
	<Container class="recipe">
		<h1>{title}</h1>

		{
			description && (
				<div class="description">
					<StructuredText data={description} />
				</div>
			)
		}

		<Card class="info-card">
			<h2>Recipe Information</h2>

			<p class="contents">
				<span class="label">Category:</span>
				<a href={`/categories/${category!.slug}`} class="value link-ghost">
					{category!.title}
				</a>
			</p>

			{
				prepTime && prepTime > 0 && (
					<p class="contents">
						<span class="label">Prep time:</span>
						<span class="value">{minutesToHours(prepTime)}</span>
					</p>
				)
			}

			{
				cookTime && cookTime > 0 && (
					<p class="contents">
						<span class="label">Cook time:</span>
						<span class="value">{minutesToHours(cookTime)}</span>
					</p>
				)
			}

			{
				totalTime && totalTime > 0 && !prepTime && !cookTime && (
					<p class="contents">
						<span class="label">Time:</span>
						<span class="value">{minutesToHours(totalTime)}</span>
					</p>
				)
			}

			{
				yields && yieldLabel && yieldValue && (
					<>
						<p class="contents">
							<span class="label">{yieldLabel}:</span>

							<div class="value adjustment-container">
								<span>
									{yieldValue}{" "}
									<span class="adjustment-display">
										(x<span data-ingredient-adjustment>1</span>)
									</span>
								</span>

								<label for="serving-adjust" class="visually-hidden">
									Adjust servings
								</label>

								<select id="serving-adjust" name="serving-adjust">
									<option value="0.25">x1/4</option>
									<option value="0.5">x1/2</option>
									<option value="0.75">x3/4</option>
									<option value="1" selected>
										x1
									</option>
									<option value="1.5">x1.5</option>
									<option value="2">x2</option>
									<option value="4">x4</option>
								</select>

								<ChevronDown class="select-icon" aria-hidden />
							</div>
						</p>
					</>
				)
			}

			{
				tags.length > 0 && (
					<>
						<p class="label">Tags:</p>

						<ul class="tags">
							{tags.map((tag) => (
								<li class="tag">
									<a href={`/tags/${tag.slug}`} class="link-ui">
										{tag.title}
									</a>
								</li>
							))}
						</ul>
					</>
				)
			}
		</Card>

		{
			ingredients && (
				<>
					<h2>Ingredients</h2>

					<StructuredText
						{...ensureValidStructuredTextProps({
							data: ingredients.value as StructuredTextDocument,
						})}
						nodeOverrides={{
							paragraph: Ingredient,
						}}
					/>
				</>
			)
		}

		{
			equipment && (
				<>
					<h2>Equipment</h2>

					<StructuredText
						{...ensureValidStructuredTextProps({
							data: equipment.value as StructuredTextDocument,
						})}
					/>
				</>
			)
		}

		{
			directions && (
				<>
					<h2>Steps</h2>

					<StructuredText
						{...ensureValidStructuredTextProps({
							data: directions.value as StructuredTextDocument,
						})}
					/>
				</>
			)
		}
	</Container>
</GlobalLayout>

<script>
	import { toFraction } from "#util/number.ts";
	import { pluralizeUnit } from "#util/units.ts";

	const select = document.querySelector('select[name="serving-adjust"]');

	const ingredients = document.querySelectorAll("[data-ingredient]");
	const adjustmentDisplay = document.querySelector(
		"[data-ingredient-adjustment]",
	);

	select?.addEventListener("change", (event) => {
		// @ts-expect-error yes it does dude
		const adjustmentAmount = parseFloat(event.target?.value || "1");

		// @ts-expect-error yes it does dude
		adjustmentDisplay.innerHTML = toFraction(adjustmentAmount);

		ingredients.forEach((ingredient) => {
			const amountEl = ingredient.querySelector("[data-ingredient-amount]");
			const unitEl = ingredient.querySelector("[data-ingredient-unit]");

			let amount = 1;

			if (amountEl) {
				const initialAmount = parseFloat(
					amountEl?.getAttribute("data-ingredient-amount") || "1",
				);

				amount = initialAmount * adjustmentAmount;

				amountEl.innerHTML = toFraction(amount);
			}

			if (unitEl) {
				const unit = unitEl?.getAttribute("data-ingredient-unit") as string;
				unitEl.innerHTML = pluralizeUnit(amount, unit);
			}
		});
	});
</script>

<style
	define:vars={{
		theme,
	}}
>
	.recipe {
		--theme: var(--theme, var(--color-accent));

		padding-block: var(--rhythm-lg);
	}
	h1 {
		margin-block-start: 0;
		margin-block-end: var(--rhythm-xs);
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-xxl);
		color: var(--theme);
	}

	h2 {
		margin-block: 0;
		font-size: var(--font-size-lg);
		font-weight: 400;
		text-decoration: underline;
		text-decoration-color: var(--theme);
	}

	:global(.recipe .description p) {
		max-width: 55ch;
		margin-block: 0;
		margin-inline: auto;
		text-align: center;
		text-wrap: pretty;
	}

	.contents {
		display: contents;
	}

	.info-card {
		display: grid;
		grid-template-columns: max-content 1fr;
		column-gap: var(--space-md);
		row-gap: var(--rhythm-sm);
		font-size: var(--font-size-sm);

		h2 {
			grid-column: 1/-1;
			font-family: var(--font-family-basier);
			text-align: center;
			text-decoration: none;
		}
	}

	.label {
		margin: 0;
		text-align: end;
	}

	.value {
		border-bottom: 1px solid var(--color-text);
	}

	label.visually-hidden {
		user-select: none;
	}

	.adjustment-display {
		color: var(--color-text-secondary);
	}

	.adjustment-container {
		position: relative;
		cursor: pointer;

		& select {
			position: absolute;
			inset: 0;
			opacity: 0;
		}
	}

	.select-icon {
		position: absolute;
		top: 0.05lh;
		right: var(--space-xs);
		width: 0.5lh;
		height: 0.5lh;
	}

	.tags {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		column-gap: var(--space-lg);
		row-gap: var(--rhythm-sm);
		margin: 0;
		padding: 0;
		list-style-type: none;
	}

	.tag {
		font-family: var(--font-family-rock-salt);
		text-shadow:
			-2px 2px 0px var(--color-card-background),
			-2px -2px 0px var(--color-card-background),
			2px 2px 0px var(--color-card-background),
			2px -2px 0px var(--color-card-background);

		&::after {
			content: "";
			position: absolute;
			right: 0;
			left: 0;
			z-index: -1;
			border-bottom: 1px solid var(--color-text);
		}
	}

	.striped-structured-text {
		margin: calc(var(--space-md) * -1);
		margin-block-start: var(--space-md);

		:global(& p) {
			margin-block: 0;
			padding-block: var(--rhythm-sm);
			padding-inline: var(--space-md);

			&:nth-of-type(odd) {
				background-color: hsl(from var(--color-background) h s l / 0.5);
			}
		}
	}
</style>
