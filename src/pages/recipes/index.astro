---
import { actions } from "astro:actions";

import { executeQuery } from "#api/datocms/execute-query.ts";
import { getAllRecipes } from "#api/queries/recipe.ts";
import PageTitle from "#components/PageTitle.astro";
import RecipeStack from "#components/RecipeStack.astro";
import Search from "#components/Search.astro";
import GlobalLayout from "#layouts/GlobalLayout.astro";

const result = Astro.getActionResult(actions.search.recipes);

const { allRecipes } = await executeQuery(getAllRecipes);

let recipes = allRecipes;

if (result?.data?.length) {
	recipes = allRecipes.filter((recipe) => result.data.includes(recipe.id));
}
---

<GlobalLayout>
	<PageTitle>The cookbook</PageTitle>

	<Search class="search" />

	<RecipeStack recipes={recipes} />
</GlobalLayout>

<style>
	.search {
		position: relative;
		top: calc(var(--rhythm-md) * -1);
		max-width: calc(var(--container-width) * 0.5);
		margin-inline: auto;
	}
</style>
