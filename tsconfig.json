{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"strictNullChecks": true,
		"paths": {
			"#*": ["./src/*"]
		},
		"plugins": [
			{
				"name": "@astrojs/ts-plugin"
			},
			{
				"name": "gql.tada/ts-plugin",
				"schema": "./schema.graphql",
				"tadaOutputLocation": "./src/lib/datocms/graphql-env.d.ts"
			}
		]
	}
}
