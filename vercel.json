{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"installCommand": "curl -fsSL https://nubjs.com/install.sh | bash && export PATH=$HOME/.nub/bin:$PATH && nub ci",
	"buildCommand": "export PATH=$HOME/.nub/bin:$PATH && nub run build",
	"redirects": [
		{
			"source": "/categories/dinner",
			"destination": "/categories/main-dish"
		},
		{
			"source": "/categories/pasta",
			"destination": "/tags/pasta"
		},
		{
			"source": "/categories/burger",
			"destination": "/tags/burger"
		},
		{
			"source": "/categories/breakfast",
			"destination": "/tags/breakfast"
		},
		{
			"source": "/categories/salad",
			"destination": "/tags/salad"
		}
	]
}
